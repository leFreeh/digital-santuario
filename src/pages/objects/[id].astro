---
import { getCollection, render } from "astro:content";

import FieldNoteLayout from "../../layouts/FieldNoteLayout.astro";
import ObjectInfo from "../../components/ObjectInfo.astro";
import ObjectNavigation from "../../components/ObjectNavigation.astro";

export async function getStaticPaths() {
    const objects = await getCollection("objects");

    return objects.map((object) => ({
        params: {
            id: object.id,
        },
    }));
}

const { id } = Astro.params;

const objects = await getCollection("objects");

const sortedObjects = [...objects].sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const currentIndex = sortedObjects.findIndex((object) => object.id === id);

if (currentIndex === -1) {
    throw new Error(`Objeto "${id}" no encontrado`);
}

const object = sortedObjects[currentIndex];

const previousObject =
    currentIndex > 0 ? sortedObjects[currentIndex - 1] : null;

const nextObject =
    currentIndex < sortedObjects.length - 1
        ? sortedObjects[currentIndex + 1]
        : null;

const { Content } = await render(object);
---

<FieldNoteLayout title={object.data.name}>
    <main class="mx-auto max-w-4xl px-6 py-12">
        <ObjectInfo object={object} />

        <article
            class="field-note-content prose prose-neutral max-w-none mt-16"
        >
            <Content />
        </article>

        <ObjectNavigation previous={previousObject} next={nextObject} />
    </main>
</FieldNoteLayout>
