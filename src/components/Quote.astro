---
interface Props {
  author?: string;
}

const { author } = Astro.props;
---

<blockquote
  class="border-l-4 border-neutral-300 pl-4 italic text-neutral-600"
>
  <slot />

  {author && (
    <footer class="mt-2 text-sm not-italic text-neutral-500">
      — {author}
    </footer>
  )}
</blockquote>