---
import type { CollectionEntry } from "astro:content";

type Props = {
    object: CollectionEntry<"objects">;
};

const { object } = Astro.props;
---

<li class="group">
    <a
        href={`/objects/${object.id}`}
        class="block overflow-hidden rounded-xl border border-neutral-200 bg-white transition hover:-translate-y-1 hover:shadow-lg"
    >
        <img
            src={object.data.image}
            alt={object.data.name}
            class="h-64 w-full object-cover"
        />

        <div class="p-5">
            <h2 class="text-xl font-semibold">
                {object.data.name}
            </h2>

            <p class="mt-2 text-sm text-neutral-500">
                {object.data.date.toLocaleDateString()}
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
                {
                    object.data.tags.map((tag) => (
                        <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-700">
                            {tag}
                        </span>
                    ))
                }
            </div>
        </div>
    </a>
</li>
