---
import type { CollectionEntry } from 'astro:content';

type Props = {
  object: CollectionEntry<'objects'>;
};

const { object } = Astro.props;
---

<header class="space-y-4">

  <div class="aspect-video overflow-hidden rounded-xl bg-neutral-100">
    <img
      src={object.data.image}
      alt={object.data.name}
      class="h-full w-full object-cover"
      loading="eager"
    />
  </div>

  <div>
    <h1 class="text-4xl font-bold">
      {object.data.name}
    </h1>

    <p class="mt-2 text-sm text-neutral-500">
      {object.data.date.toLocaleDateString()}
    </p>
  </div>

  <div class="flex flex-wrap gap-2">
    {object.data.tags.map((tag) => (
      <span
        class="rounded-full bg-neutral-100 px-3 py-1 text-sm text-neutral-700"
      >
        {tag}
      </span>
    ))}
  </div>

</header>